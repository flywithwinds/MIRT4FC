#
假
设YY
是
你
的data.frame
#
将YY
转
换
成
长
格
式
row_indices <- rep(1:nrow(YY), times = ncol(YY))
col_indices <- rep(1:ncol(YY), each = nrow(YY))
values <- as.vector(as.matrix(YY))
output <- data.frame(row = row_indices, col = col_indices, value = values)
#
定
义
映
射
表
mapping <- list(
`6` = c(1, 2, 3),
`5` = c(1, 3, 2),
`4` = c(2, 1, 3),
`3` = c(2, 3, 1),
`2` = c(3, 1, 2),
`1` = c(3, 2, 1)
)
#
添
加
新
列 (
根
据
值)
new_cols <- t(sapply(output$value, function(v) mapping[[as.character(v)]]))
output <- cbind(output, as.data.frame(new_cols))
colnames(output)[4:6] <- c("new_col1", "new_col2", "new_col3")
#
添
加
再
新
三
列 (
根
据
列
号col)
extra_cols <- data.frame(
extra_col1 = 3 * output$col - 2,
extra_col2 = 3 * output$col - 1,
extra_col3 = 3 * output$col
)
output <- cbind(output, extra_cols)
#
按 row
排
序
output <- output[order(output$row), ]
#
保
存
为csv
write.csv(output, file = "output.csv", row.names = FALSE)

#
计
算
最
大
后
验
估
计 (point estimate)
Wasserstein.est <- c()
for (jj in 1:J) {
p <-  rbind(LC.prob[,jj ], 1 - LC.prob[, jj])
w1 <- matrix(data = w, ncol = 1)
w2 <- rbind(t(w1),t(w1))
p1 <- p*w2
pp <- diag(1/rowSums(p1))%*%p1
prob<-p %*% w1
Wasserstein.est[jj] <- wasserstein1d(prob[,1]%*%pp,posterior)
}
# for (j in 1:J) {
#   MPj<-sum(LC.prob[,j]*posterior)
#   Qj<-LC.prob[,j]/2^K
#   F_MPj<-cumsum(rep(MPj, length(Qj)))
#   F_Qj <-cumsum(Qj)
#   Wasserstein.est[j] <- posterior*LC.prob[,j]/sum(posterior*LC.prob[,j])+
#                         posterior*(1-LC.prob[,j])/sum(posterior*(1-LC.prob[,j]))
#   #Wasserstein.est[j] <- sum(posterior*abs(MPj-Qj))
#   #Wasserstein.est[j] <- sum(posterior*wasserstein1d(Pj,Qj))
#   #Wasserstein.est[j] <- sum(posterior*abs(cumsum(Pj)/sum(cumsum(Pj))-cumsum(Qj)))
# }
if (sum(p.items) == J) {
next_item <- which(Wasserstein.est == max(Wasserstein.est[which(flag == 0)]))
if (length(next_item) < 1) stop("No valid next item")
if (length(next_item) > 1) return(sample(next_item, size = 1))
return(next_item)
} else {
Wasserstein.est[which(flag == 1)] <- min(Wasserstein.est) - 1  #
排
除
已
作
答
题
目
itemcode <- order(Wasserstein.est, decreasing = TRUE)[1:ceiling(0.01 * J)]
items <- matrix(c(itemcode, p.items[itemcode]), length(itemcode), 2)
return(items[which.max(items[, 2]), 1])
}
}
